# RedConnect environment variables - copy this file to .env and fill in your values.

# Server
SERVER_PORT=8080

# PostgreSQL database - create the database first:
#   CREATE DATABASE redconnect;
# Then set the connection details below. Rows (user profiles, blood data) are
# persisted line-by-line into PostgreSQL tables.
DB_URL=jdbc:postgresql://localhost:5432/redconnect
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT - use a long random string (at least 32 characters)
JWT_SECRET=redconnect-capstone-change-this-secret-key-to-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000